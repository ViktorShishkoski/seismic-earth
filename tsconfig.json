{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    // Explicit .ts extensions let Node run the relay server directly (type stripping,
    // no build step) while Vite resolves the same imports for the browser.
    "allowImportingTsExtensions": true,
    "types": ["@webgpu/types", "vite/client"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["src", "tests", "server", "scripts", "vite.config.ts"]
}
